logs/
*.log

# Cache
.cache/
.turbo/
.eslintcache

# Large marketing videos — keep locally / on CDN, do not commit binaries.
# Re-encode with: npm run optimize:videos
# Serve via CDN by setting NEXT_PUBLIC_VIDEO_CDN_URL
/public/images/FALLING_diam.mp4
/public/images/world_net.mp4
/public/images/video1.mp4
/public/New-Videos/*.mp4

*.md